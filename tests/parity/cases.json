      "remote": "https://github.com/owner/repo.git",
      "branch": "main"
    }
  },
  {
    "name": "mock_completed_message",
    "kind": "mock",
    "spec": "completed",
    "args": ["--message", "hello world"],
    "local_repo": {
      "remote": "https://github.com/owner/repo.git",
      "branch": "main"
    }
  },
  {
    "name": "mock_completed_explicit_branch",
    "kind": "mock",
