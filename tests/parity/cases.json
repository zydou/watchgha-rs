[
  {
    "name": "help",
    "kind": "plain",
    "args": ["--help"],
    "structural_stdout": [
      "--sha", "--poll", "--wait", "--wait-for-start",
      "--only", "--message", "--help", "REPO", "BRANCH"
    ]
  },
  {
